// Quests, in the order they unlock (a quest can only require one before it). `giver` offers it and `turn_in` takes it
// back (creature ids); `goals` are Kill(creature, count) and Collect(item, count) (carried items; they are taken at the
// turn in). Texts: `details` is what is said when it is offered, `objective` the line in the log, `progress` what is said
// while it is unfinished, `completion` what is said at the turn in; `$N` is the player's name. The reward is copper, experience, items
// given to everyone (item, count) and `choice`: items of which the player takes one. Left out: no goals, no requirement, no reward.
[
    (
        id: "wolves_in_the_valley",
        title: "Wolves in the Valley",
        giver: "deputy_willem",
        turn_in: "deputy_willem",
        details: "The wolves in the valley west of here have grown bold, $N. Travellers on the road to Goldshire are not safe, and I cannot leave my post. Thin them out for me, and bring me a piece of their meat so that I know the job is done.",
        objective: "Kill 2 wolves and bring Deputy Willem 1 piece of Tough Wolf Meat.",
        progress: "Have you dealt with those wolves yet? I need two of them dead and a piece of their meat.",
        completion: "Good work, $N. The road will be a little safer tonight. Take this for your trouble.",
        goals: [Kill("wolf", 2), Collect("tough_wolf_meat", 1)],
        reward: (copper: 100, xp: 150, choice: [("i80", 1), ("i6070", 1)], items: [("linen_cloth", 2)]),
    ),
    (
        id: "a_word_with_the_trader",
        title: "A Word with the Trader",
        giver: "deputy_willem",
        turn_in: "trader_aldric",
        details: "Trader Aldric has been complaining that nobody brings him pelts since the wolves came down from the hills. Now that you have shown what you can do, go and tell him the valley is open to his customers again. He is not far from here.",
        objective: "Speak with Trader Aldric.",
        progress: "Trader Aldric is waiting to hear from you, $N.",
        completion: "So the valley is quiet again? Good news, $N, good news indeed. Here, a little something for the message.",
        requires: Some("wolves_in_the_valley"),
        reward: (copper: 50, xp: 50),
    ),
    (
        id: "pelts_for_aldric",
        title: "Pelts for Aldric",
        giver: "trader_aldric",
        turn_in: "trader_aldric",
        details: "Even a ruined pelt will fetch something from the tanners in Goldshire, $N. Bring me two of them from the wolves, and I will pay you well above the usual rate.",
        objective: "Bring Trader Aldric 2 Ruined Pelts.",
        progress: "Two pelts, $N. Not one, not three. Two.",
        completion: "Fine pelts, even ruined ones! Here is your pay, and thank you.",
        goals: [Collect("ruined_pelt", 2)],
        requires: Some("a_word_with_the_trader"),
        reward: (copper: 200, xp: 200),
    ),
    // ---- The Dark Beacon (STORY_NORTHSHIRE.md)
    (
        id: "rats_in_the_cellar",
        title: "Rats in the Cellar",
        giver: "brother_tolan",
        turn_in: "brother_tolan",
        details: "Two hundred years that cellar was clean, $N, and now every step has a rat on it. I am a keeper of wine, not a fighter. If you would clear five of them out for me, the abbey would be in your debt.",
        objective: "Kill 5 Cellar Rats.",
        progress: "Still I hear them in the walls, $N. Five, if you please.",
        completion: "Quiet at last! The brothers will sleep tonight. Take this for your trouble, and go and see the Abbot: he will want to meet you.",
        goals: [Kill("cellar_rat", 5)],
        reward: (copper: 80, xp: 100, items: [("linen_cloth", 2)]),
    ),
    (
        id: "broth_for_the_brothers",
        title: "Broth for the Brothers",
        giver: "brother_corwin",
        turn_in: "brother_corwin",
        details: "The brothers have lived on bread and cabbage since the Beacon went out, and it shows. The boars that have been rooting in the vineyard would make a fine broth. Bring me four pieces of boar meat and I will see that you are warm on your travels.",
        objective: "Bring Brother Corwin 4 pieces of Boar Meat.",
        progress: "A good broth wants four pieces of boar meat, $N. Not a scrap less.",
        completion: "This will put some colour back in their faces. Here: the brothers' gift, a choice of warm things for the road.",
        goals: [Collect("boar_meat", 4)],
        reward: (copper: 60, xp: 140, choice: [("i11475", 1), ("i2690", 1)]),
    ),
    (
        id: "the_dark_beacon",
        title: "The Dark Beacon",
        giver: "abbot_hollis",
        turn_in: "deputy_willem",
        details: "Three weeks ago the Beacon in our tower went dark. The lens was taken, $N, on my watch. I cannot leave the abbey, and the brothers are no men of war. Deputy Willem keeps the road at night: ask him who has been about after dark. He will tell you what he knows.",
        objective: "Ask Deputy Willem about the stolen lens.",
        progress: "Have you spoken with the deputy yet, $N?",
        completion: "The Abbot sent you? So the lens is gone. I did wonder why the valley has been so dark and so full of vermin. Well: I know whose fault part of it is.",
        requires: Some("rats_in_the_cellar"),
        reward: (copper: 30, xp: 60),
    ),
    (
        id: "the_redhand_at_the_bridge",
        title: "The Redhand at the Bridge",
        giver: "deputy_willem",
        turn_in: "deputy_willem",
        details: "The Redhand is a gang of cutpurses that has squatted at the Stone Bridge, west of here, for a month now. They rob everyone on the Goldshire road and nobody has been able to stop them. I cannot leave my post. Thin them out, $N: five of them, and I will make it worth your while.",
        objective: "Kill 5 Redhand Cutpurses.",
        progress: "The bridge is still crawling with them, $N. Five of the cutpurses, if you please.",
        completion: "They will think twice before robbing a traveller now. Here is something for your trouble. But I have heard that their captain is no stranger to the abbey.",
        goals: [Kill("redhand_cutpurse", 5)],
        requires: Some("the_dark_beacon"),
        reward: (copper: 120, xp: 220, items: [("lockpick", 3)]),
    ),
    (
        id: "garrick_thorne",
        title: "Garrick Thorne",
        giver: "deputy_willem",
        turn_in: "deputy_willem",
        details: "Their captain is a man called Garrick Thorne. Eleven years he was the abbey's steward: he kept the keys. He owes the Redhand more than he can pay, and they say he paid it with something from the abbey. Find him at the camp by the bridge, $N, and bring me whatever he carries.",
        objective: "Kill Garrick Thorne and bring Deputy Willem the Torn Ledger Page.",
        progress: "Garrick Thorne is at the Stone Bridge, $N. Bring me what he carries.",
        completion: "'Sold to the kobolds of Echo Ridge, for coin and candles.' So that is where the lens went! Take this: it was his, and it should serve you better than it served him. Go to the Abbot now.",
        goals: [Kill("garrick_thorne", 1), Collect("torn_ledger", 1)],
        requires: Some("the_redhand_at_the_bridge"),
        reward: (copper: 200, xp: 300, items: [("thorne_dagger", 1)], choice: [("i6076", 1), ("i60", 1), ("i3070", 1)]),
    ),
    (
        id: "candles_in_the_dark",
        title: "Candles in the Dark",
        giver: "abbot_hollis",
        turn_in: "abbot_hollis",
        details: "Kobolds! Of course. They have been stealing our candles for months, and now it seems they have our lens too. The brothers cannot even hold the evening office by candlelight. Echo Ridge Mine lies north of the abbey: bring me six of our candles back from the kobolds who dig there, and we shall see what else they hold.",
        objective: "Bring Abbot Hollis 6 Abbey Candles.",
        progress: "The kobolds of Echo Ridge Mine are to the north, $N. Six candles, and then we will speak of the lens.",
        completion: "Six candles! The brothers will sing tonight. But the lens is still down there, and a kobold foreman sits on it. Will you go and fetch it?",
        goals: [Collect("abbey_candle", 6)],
        requires: Some("garrick_thorne"),
        reward: (copper: 150, xp: 280),
    ),
    (
        id: "the_lens_below",
        title: "The Lens Below",
        giver: "abbot_hollis",
        turn_in: "abbot_hollis",
        details: "Foreman Gribble is the kobold who bought the lens. He holds the yard before Echo Ridge Mine, and he will not give it up for love: it is the biggest shiny candle he has ever seen. Take it from him, $N, and bring it home. The Light go with you.",
        objective: "Kill Foreman Gribble and bring Abbot Hollis the Beacon Lens.",
        progress: "The lens is with the foreman at the mouth of Echo Ridge Mine, $N. Bring it home.",
        completion: "The Beacon! Tonight, for the first time in three weeks, it will burn, and the whole valley will see it. Choose, $N: whatever the abbey has to give is yours.",
        goals: [Kill("foreman_gribble", 1), Collect("beacon_lens", 1)],
        requires: Some("candles_in_the_dark"),
        reward: (copper: 400, xp: 500, choice: [("abbey_mace", 1), ("abbey_buckler", 1), ("beaconkeeper_tunic", 1)]),
    ),
]
