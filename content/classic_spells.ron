    (id: "s20204", spell: 20204, name: "zzOLDBlessing of Sanctuary", rank: "Rank 1", icon: "Spell_Nature_LightningShield", school: 1, dispel: 1, level: 20, base_level: 20, cost: 45, gcd: 1500, attributes: 327680, family: 10, family_flags: 268435456, range: 30.0, duration: 300000, proc: (40, 100, 0), effects: [(kind: 6, aura: 14, low: -7, high: -7, misc: 127, targets: (21, 0)), (kind: 6, aura: 43, low: 10, high: 10, targets: (21, 0))], text: "Places a Blessing on the friendly target, reducing damage dealt from all sources by up to 7 for 5 min.  In addition, when the target blocks a melee attack the attacker will take 10 Holy damage.  Players may only have one Blessing on them per Paladin at any one time."),
