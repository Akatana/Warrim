    (id: "s14318", spell: 14318, name: "Aspect of the Hawk", rank: "Rank 2", icon: "Spell_Nature_RavenForm", school: 3, level: 18, base_level: 18, cost: 35, gcd: 1500, attributes: 327680, family: 9, family_flags: 1048576, proc: (87376, 0, 0), effects: [(kind: 6, aura: 124, low: 35, high: 35, targets: (1, 0)), (kind: 6, aura: 42, trigger: 6150, targets: (1, 0))], text: "The hunter takes on the aspects of a hawk, increasing Ranged Attack Power by 35.  Only one Aspect can be active at a time."),
