    (id: "s20154", spell: 20154, name: "Seal of Righteousness", rank: "Rank 1", icon: "Ability_ThunderBolt", school: 1, dispel: 1, level: 1, base_level: 1, max_level: 7, cost: 20, gcd: 1500, attributes: 327680, family: 10, family_flags: 134217728, duration: 30000, proc: (4, 100, 0), effects: [(kind: 6, aura: 4, low: 108, high: 108, per_level: 18.0, targets: (1, 0))], text: "Fills the Paladin with holy spirit for 30 sec, granting each melee attack an additional 1.2 to 4.3 Holy damage.  Slower weapons cause more Holy damage per swing.  Only one Seal can be active on the Paladin at any one time."),
