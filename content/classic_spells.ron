    (id: "s20162", spell: 20162, name: "Seal of the Crusader", rank: "Rank 2", icon: "Spell_Holy_HolySmite", school: 1, dispel: 1, level: 12, base_level: 12, max_level: 20, cost: 40, gcd: 1500, attributes: 327680, family: 10, family_flags: 512, duration: 30000, effects: [(kind: 6, aura: 99, low: 51, high: 51, per_level: 1.1, targets: (1, 0)), (kind: 6, aura: 9, low: 40, high: 40, targets: (1, 0)), (kind: 6, aura: 4, low: 20188, high: 20188, targets: (1, 0))], text: "Fills the Paladin with the spirit of a crusader for 30 sec, granting 51 melee attack power.  The Paladin also attacks 40% faster, but deals less damage with each attack.  Only one Seal can be active on the Paladin at any one time.\n\nUnleashing this Seal's energy will judge an enemy for 10 sec, increasing Holy damage taken by up to 30.  Your melee strikes will refresh the spell's duration.  Only one Judgement per Paladin can be active at any one time."),
    (id: "s20163", spell: 20163, name: "zzOLDSeal of Fury", rank: "Rank 1", icon: "Spell_Holy_SealOfFury", school: 1, dispel: 1, level: 16, base_level: 16, cost: 55, gcd: 1500, attributes: 327680, family: 10, family_flags: 134217728, duration: 30000, proc: (20, 100, 0), effects: [(kind: 6, aura: 42, trigger: 20231, targets: (1, 0)), (kind: 6, aura: 4, low: 20183, high: 20183, targets: (1, 0))], text: "Fills the Paladin with divine fury for 30 sec, allowing melee attacks to cause additional threat.  Only one Seal can be active on the Paladin at any one time.\n\nUnleashing this Seal's energy will judge an enemy for 30 sec, causing Holy damage spells cast on that enemy to generate additional threat.  Only one Judgement per Paladin can be active at any one time."),
    (id: "s20164", spell: 20164, name: "Seal of Justice", icon: "Spell_Holy_SealOfWrath", school: 1, dispel: 1, level: 22, base_level: 22, cost_percent: 13, gcd: 1500, attributes: 327680, family: 10, family_flags: 134217728, duration: 30000, proc: (20, 100, 0), effects: [(kind: 6, aura: 42, trigger: 20170, targets: (1, 0)), (kind: 6, aura: 4, low: 20184, high: 20184, targets: (1, 0))], text: "Fills the Paladin with the spirit of justice for 30 sec, giving each melee attack a chance to stun for 2 sec.  Only one Seal can be active on the Paladin at any one time.\n\nUnleashing this Seal's energy will judge an enemy for 10 sec, preventing them from fleeing.  Your melee strikes will refresh the spell's duration.  Only one Judgement per Paladin can be active at any one time."),
    (id: "s20165", spell: 20165, name: "Seal of Light", rank: "Rank 1", icon: "Spell_Holy_HealingAura", school: 1, dispel: 1, level: 30, base_level: 30, cost: 110, gcd: 1500, attributes: 327680, family: 10, family_flags: 134217728, duration: 30000, proc: (20, 100, 0), effects: [(kind: 6, aura: 42, trigger: 20167, targets: (1, 0)), (kind: 6, aura: 4, low: 20185, high: 20185, targets: (1, 0))], text: "Fills the Paladin with divine light for 30 sec, giving each melee attack a chance to heal the Paladin for 39.  Only one Seal can be active on the Paladin at any one time.\n\nUnleashing this Seal's energy will judge an enemy for 10 sec, granting melee attacks made against the judged enemy a chance of healing the attacker for 25.  Your melee strikes will refresh the spell's duration.  Only one Judgement per Paladin can be active at any one time."),
    (id: "s20166", spell: 20166, name: "Seal of Wisdom", rank: "Rank 1", icon: "Spell_Holy_RighteousnessAura", school: 1, dispel: 1, level: 38, base_level: 38, cost: 135, gcd: 1500, attributes: 327680, family: 10, family_flags: 134217728, duration: 30000, proc: (20, 100, 0), effects: [(kind: 6, aura: 42, trigger: 20168, targets: (1, 0)), (kind: 6, aura: 4, low: 20186, high: 20186, targets: (1, 0))], text: "Fills the Paladin with divine wisdom for 30 sec, giving each melee attack a chance to restore 50 of the Paladin's mana.  Only one Seal can be active on the Paladin at any one time.\n\nUnleashing this Seal's energy will judge an enemy for 10 sec, granting attacks and spells used against the judged enemy a chance to restore 33 mana to the attacker.  Your melee strikes will refresh the spell's duration.  Only one Judgement per Paladin can be active at any one time."),
    (id: "s20167", spell: 20167, name: "Seal of Light", rank: "Rank 1", icon: "Spell_Holy_HealingAura", school: 1, level: 30, base_level: 30, attributes: 262144, family: 10, family_flags: 262144, effects: [(kind: 10, low: 39, high: 39, targets: (1, 0))]),
