    (id: "s14310", spell: 14310, name: "Freezing Trap", rank: "Rank 2", icon: "Spell_Frost_ChainsOfIce", school: 4, level: 40, base_level: 40, cost: 75, gcd: 1500, attributes: 268500992, family: 9, family_flags: 128, duration: 60000, effects: [(kind: 104, low: 1, high: 1, radius: 2.0, misc: 164876, targets: (47, 0))], text: "Place a frost trap that freezes the first enemy that approaches, preventing all action for up to 15 sec.  Any damage caused will break the ice.  Trap will exist for 1 min.  Traps can only be placed when out of combat.  Only one trap can be active at a time."),
    (id: "s14311", spell: 14311, name: "Freezing Trap", rank: "Rank 3", icon: "Spell_Frost_ChainsOfIce", school: 4, level: 60, base_level: 60, cost: 100, gcd: 1500, attributes: 268500992, family: 9, family_flags: 128, duration: 60000, effects: [(kind: 104, low: 1, high: 1, radius: 2.0, misc: 164877, targets: (47, 0))], text: "Place a frost trap that freezes the first enemy that approaches, preventing all action for up to 20 sec.  Any damage caused will break the ice.  Trap will exist for 1 min.  Traps can only be placed when out of combat.  Only one trap can be active at a time."),
