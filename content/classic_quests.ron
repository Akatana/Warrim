    (id: "q7811", title: "A Donation of Runecloth", giver: "c14724", turn_in: "c14724", details: "", objective: "A Donation of Runecloth", progress: "$n, you've been a tremendous contributor to our cloth drive. As we work hard to replenish our reserves, one form of cloth remains critically low - runecloth. We are in absolutely dire need of runecloth, and we hope that you will be able to help us as you have in the past.\n\nIf you are willing, please bring me what runecloth you can spare. We'll initially accept a single donation of sixty, and then we'll go from there.", completion: "Fantastic - these will go right to use, I assure you. Thank you again for your assistance! We'd certainly be lost without you.\n\nWith all the donations you've made, I would certainly process any additional runecloth donations you care to make in the future. Just be sure to check in with me, and I'll personally make sure that your good deeds won't go unrecognized!", goals: [Collect("i14047", 60)], level: 60, min_level: 50, races: 77, reward: (xp: 6600)),
    (id: "q7813", title: "A Donation of Wool", giver: "c14729", turn_in: "c14729", details: "", objective: "A Donation of Wool", progress: "We are currently accepting donations for wool cloth. A donation of sixty pieces of wool cloth will net you full recognition by the Undercity for your generous actions. Our stores are such on wool that we would only need sixty pieces from you total; we should be able to acquire enough from others in the realm to support our drive.\n\nIf you have the sixty pieces of wool cloth on you and are ready to donate them, I'm able to take them from you now.", completion: "Wonderful! We thank you for your generous donation, $N!", goals: [Collect("i2592", 60)], level: 60, min_level: 12, races: 178, reward: (xp: 650)),
    (id: "q7814", title: "A Donation of Silk", giver: "c14729", turn_in: "c14729", details: "", objective: "A Donation of Silk", progress: "As with most other fabrics, our stocks of silk are at an all-time low. Our stores are such that we'd only need sixty pieces of silk from you total; we should be able to reach our goal with the support of others.\n\nA benevolent gift such as silk, might I add, would certainly increase your local standing in the community! If you have the sixty pieces of silk cloth on you and are ready to donate them, I'm able to take them from you now.", completion: "Wonderful! We thank you for your generous donation, $N!", goals: [Collect("i4306", 60)], level: 60, min_level: 26, races: 178, reward: (xp: 1650)),
    (id: "q7815", title: "Snapjaws, Mon!", giver: "c14740", turn_in: "c14740", details: "Don't let their big eyes fool you, mon! Those saltwater snapjaws be a menace. I can't fish for five minutes without getting a broken line from one of those oversized fish vacuums stealing my bait.\n\nDo me and the people of Revantusk Village a service and kill em, mon.\n\nKill the whole lot of em!", objective: "Katoom the Angler at Revantusk Village in the Hinterlands wants you to kill 15 Saltwater Snapjaw turtles. Return to him when you have completed this task.", progress: "How goes the hunt?", completion: "Oh, mon! I can't thank you enough! Hopefully this here fishing pole will be reward enough for the job.", goals: [Kill("c2505", 15)], level: 50, min_level: 44, races: 178, reward: (copper: 7500, xp: 4700, items: [("i19022", 1)])),
    (id: "q7817", title: "A Donation of Mageweave", giver: "c14729", turn_in: "c14729", details: "", objective: "A Donation of Mageweave", progress: "Mageweave is running low, and we could use your help to replenish our stocks! By counting on the community as a whole, we would only need a donation of 60 pieces of mageweave cloth from you to enable us to reach our goal. Such generosity would not go unnoticed by the Undercity, I assure you!\n\nIf you have the sixty pieces of mageweave cloth on you and are ready to donate them, I'm able to take them from you now.", completion: "Wonderful! We thank you for your generous donation, $N!", goals: [Collect("i4338", 60)], level: 60, min_level: 40, races: 178, reward: (xp: 3300)),
    (id: "q7818", title: "A Donation of Runecloth", giver: "c14729", turn_in: "c14729", details: "", objective: "A Donation of Runecloth", progress: "$n, you've been a tremendous contributor to our cloth drive. As we work hard to replenish our reserves, one form of cloth remains critically low - runecloth. We are in absolutely dire need of runecloth, and we hope that you will be able to help us as you have in the past.\n\nIf you are willing, please bring me what runecloth you can spare. We'll initially accept a single donation of sixty, and then we'll go from there.", completion: "Fantastic - these will go right to use, I assure you. Thank you again for your assistance! We'd certainly be lost without you.\n\nWith all the donations you've made, I would certainly process any additional runecloth donations you care to make in the future. Just be sure to check in with me, and I'll personally make sure that your good deeds won't go unrecognized!", goals: [Collect("i14047", 60)], level: 60, min_level: 50, races: 178, reward: (xp: 6600)),
    (id: "q7820", title: "A Donation of Wool", giver: "c14728", turn_in: "c14728", details: "", objective: "A Donation of Wool", progress: "We are currently accepting donations for wool cloth.  A donation of sixty pieces of wool cloth will net you full recognition by Thunder Bluff for your generous actions.  Our stores are such on wool that we would only need sixty pieces from you total; we should be able to acquire enough from others in the realm to support our drive.\n\nIf you have the sixty pieces of wool cloth on you and are ready to donate them, I'm able to take them from you now.", completion: "Wonderful! We thank you for your generous donation, $N!", goals: [Collect("i2592", 60)], level: 60, min_level: 12, races: 178, reward: (xp: 650)),
    (id: "q7821", title: "A Donation of Silk", giver: "c14728", turn_in: "c14728", details: "", objective: "A Donation of Silk", progress: "As with most other fabrics, our stocks of silk are at an all-time low.  Our stores are such that we'd only need sixty pieces of silk from you total; we should be able to reach our goal with the support of others.\n\nA benevolent gift such as silk, might I add, would certainly increase your local standing in the community!  If you have the sixty pieces of silk cloth on you and are ready to donate them, I'm able to take them from you now.", completion: "Wonderful! We thank you for your generous donation, $N!", goals: [Collect("i4306", 60)], level: 60, min_level: 26, races: 178, reward: (xp: 1650)),
    (id: "q7822", title: "A Donation of Mageweave", giver: "c14728", turn_in: "c14728", details: "", objective: "A Donation of Mageweave", progress: "Mageweave is running low, and we could use your help to replenish our stocks!  By counting on the community as a whole, we would only need a donation of 60 pieces of mageweave cloth from you to enable us to reach our goal.  Such generosity would not go unnoticed by Thunder Bluff, I assure you!\n\nIf you have the sixty pieces of mageweave cloth on you and are ready to donate them, I'm able to take them from you now.", completion: "Wonderful! We thank you for your generous donation, $N!", goals: [Collect("i4338", 60)], level: 60, min_level: 40, races: 178, reward: (xp: 3300)),
