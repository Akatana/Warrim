    "c17072": (greeting: "Greetings, $N."),
    "c17079": (greeting: "Greetings, $N."),
    "c17080": (greeting: "Greetings, $N."),
    "c17081": (greeting: "Greetings, $N."),
    "c17082": (greeting: "Greetings, $N."),
    "c17249": (greeting: "Welcome, $N. I am Landro Longshot - manager of the Black Flame. Perhaps you've not heard of the Black Flame until now. That doesn't surprise me; we work to keep things that way. We prefer to avoid... factional entanglements.\n\nThe Black Flame specializes in providing the finest services and entertainment money can buy, whether they happen to be hard to find items, gladiatorial combat, or lucrative games of chance.\n\nAre you here seeking something specific?"),
    "c17598": (greeting: "Greetings, $N."),
    "c17804": (greeting: "Greetings, $N."),
}
