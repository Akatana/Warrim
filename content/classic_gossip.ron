    "c2705": (greeting: "Greetings, $N."),
    "c2706": (greeting: "Thanks to the Warchief, even here in the remains of our former prison, some hope remains, and the Horde rises anew."),
    "c2708": (greeting: "Pleased to meet you, $c."),
    "c2711": (greeting: "Greetings, $N."),
