    "c11036": (greeting: "Greetings, $N."),
    "c11037": (greeting: "You want to train? With me? Fantastic! The only thing better than assembling bullets and explosive devices is to share that knowledge with someone else! Let's get started!"),
    "c11038": (greeting: "Greetings, $N."),
    "c11039": (greeting: "Greetings, $N."),
