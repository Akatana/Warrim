    (id: "create_spellstone_major", spell: 17728, name: "Create Spellstone (Major)", class: Warlock, level: 100, icon: "INV_Misc_Gem_Sapphire_01", cost: Mana(550.0), cooldown: 5.0, effect: Classic(range: 0.0), then: [Conjure(item: 13603, count: 1)],
        description: "Creates a Major Spellstone for the caster. When equipped and used, the Major Spellstone removes all magic effects from the caster and will absorb 900 magic damage for 1 min. In addition, equipping the Major Spellstone improves your chance to get a critical strike with spells by 1%. Conjured items disappear if logged out for more than 15 minutes."),
    (id: "conflagrate_rank_4", spell: 18932, name: "Conflagrate (Rank 4)", class: Warlock, level: 100, icon: "Spell_Fire_Fireball", cost: Mana(140.0), cooldown: 10.0, effect: Damage(min: 447.0, max: 557.0, range: 30.0),
        description: ""),
    (id: "dark_pact_rank_3", spell: 18938, name: "Dark Pact (Rank 3)", class: Warlock, level: 100, icon: "Spell_Shadow_DarkRitual", cost: Mana(0.0), cooldown: 1.5, effect: Classic(range: 0.0),
        description: "Drains 250 of your pet's Mana, returning 100% to you."),
    (id: "create_soulstone_major", spell: 20757, name: "Create Soulstone (Major)", class: Warlock, level: 100, icon: "Spell_Shadow_SoulGem", cost: Mana(47.0), cooldown: 3.0, effect: Classic(range: 0.0), then: [Conjure(item: 16896, count: 1)],
        description: "Creates a Major Soulstone. The Soulstone can be used to store one target's soul. If the target dies while his soul is stored, he will be able to resurrect with 2200 health and 2800 mana. Conjured items disappear if logged out for more than 15 minutes."),
    (id: "summon_dreadsteed", spell: 23161, name: "Summon Dreadsteed", class: Warlock, level: 100, icon: "Ability_Mount_Dreadsteed", cost: Mana(82.0), cooldown: 3.0, effect: Classic(range: 0.0), then: [Mount(display: 14554, percent: 100)],
        description: "Summons a Dreadsteed, which serves as a mount for the caster. Speed is increased by 100%."),

