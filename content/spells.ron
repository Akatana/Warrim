// Spells: two for each class, a basic one (`level: 1`, which asks for nothing) and a greater one whose tome (an item of items.ron with a
// `tome`) asks for that rank of the class skill (`level`). `cost` is mana or stamina, `cooldown` seconds. The effect is `Damage` (the
// selected creature within `range` yards), `Area` (every enemy within `radius` yards of the caster) or `Heal` (the caster); the numbers
// are those of level 1 and grow with the rank of the class skill, which casting trains, and with the character level (`levels::spell_scale`; the mana cost grows with it too). `spell` is the row of the original's Spell.dbc whose cast time, pictures
// (SpellVisual.dbc: what shows on the hands while it is cast, the missile, what shows where it hits) and sounds it has. Icons are names
// in Interface\Icons.
[
    (id: "heroic_strike", spell: 78, name: "Heroic Strike", class: Warrior, level: 1, icon: "Ability_Rogue_Ambush", cost: Stamina(15.0), cooldown: 1.5, effect: Damage(min: 8.0, max: 14.0, range: 4.0),
        description: "A mighty blow that hits harder than a sword's swing."),
    (id: "thunder_clap", spell: 6343, name: "Thunder Clap", class: Warrior, level: 20, icon: "Spell_Nature_ThunderClap", cost: Stamina(30.0), cooldown: 6.0, effect: Area(min: 14.0, max: 20.0, radius: 8.0),
        description: "Slams the ground, hurting every enemy around you."),

    (id: "holy_light", spell: 635, name: "Holy Light", class: Paladin, level: 1, icon: "Spell_Holy_HolyBolt", cost: Mana(20.0), cooldown: 3.0, effect: Heal(min: 18.0, max: 26.0),
        description: "Calls on the Light to heal your wounds."),
    (id: "exorcism", spell: 879, name: "Exorcism", class: Paladin, level: 20, icon: "Spell_Holy_Excorcism", cost: Mana(35.0), cooldown: 6.0, effect: Damage(min: 30.0, max: 40.0, range: 25.0),
        description: "Banishes the target with a burst of holy power."),

    (id: "arcane_shot", spell: 3044, name: "Arcane Shot", class: Hunter, level: 1, icon: "Ability_ImpalingBolt", cost: Mana(15.0), cooldown: 2.0, effect: Damage(min: 10.0, max: 14.0, range: 35.0),
        description: "A shot of magic that flies straight to the target."),
    (id: "volley", spell: 1510, name: "Volley", class: Hunter, level: 20, icon: "Ability_UpgradeMoonGlaive", cost: Mana(40.0), cooldown: 6.0, effect: Area(min: 20.0, max: 28.0, radius: 10.0),
        description: "Rains arrows on everything near you."),

    (id: "sinister_strike", spell: 1752, name: "Sinister Strike", class: Rogue, level: 1, icon: "Spell_Shadow_RitualOfSacrifice", cost: Stamina(15.0), cooldown: 1.5, effect: Damage(min: 9.0, max: 13.0, range: 4.0),
        description: "A quick, dirty blow."),
    (id: "eviscerate", spell: 2098, name: "Eviscerate", class: Rogue, level: 20, icon: "Ability_Rogue_Eviscerate", cost: Stamina(35.0), cooldown: 6.0, effect: Damage(min: 40.0, max: 55.0, range: 4.0),
        description: "A deep cut that finishes a wounded enemy."),

