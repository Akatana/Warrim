    (id: "mend_pet_rank_7", spell: 13544, name: "Mend Pet (Rank 7)", class: Hunter, level: 100, icon: "Ability_Hunter_MendPet", cost: Mana(264.0), cooldown: 1.5, effect: Classic(range: 0.0), then: [MendPet(25.0)],
        description: "Heals your pet 245 health every second while you focus. Lasts 5 sec."),
    (id: "wing_clip_rank_3", spell: 14268, name: "Wing Clip (Rank 3)", class: Hunter, level: 100, icon: "Ability_Rogue_Trip", cost: Mana(44.0), cooldown: 1.5, effect: Damage(min: 50.0, max: 50.0, range: 4.0), then: [Slow(share: 0.4, seconds: 10.0)],
        description: "Inflicts {range} damage and reduces the enemy target's movement speed by 60% for 10 sec."),
    (id: "arcane_shot_rank_8", spell: 14287, name: "Arcane Shot (Rank 8)", class: Hunter, level: 100, icon: "Ability_ImpalingBolt", cost: Mana(105.0), cooldown: 6.0, effect: Damage(min: 183.0, max: 183.0, range: 35.0),
        description: "An instant shot that causes {range} Arcane damage."),
    (id: "freezing_trap_rank_3", spell: 14311, name: "Freezing Trap (Rank 3)", class: Hunter, level: 100, icon: "Spell_Frost_ChainsOfIce", cost: Mana(55.0), cooldown: 15.0, effect: Classic(range: 0.0), then: [Place(entry: 0, spell: 14309, kind: Trap, seconds: 60.0, radius: 5.0, slot: 0, uses: 0)],
        description: "Place a frost trap that freezes the first enemy that approaches, preventing all action for up to 20 sec. Any damage caused will break the ice. Trap will exist for 1 min. Traps can only be placed when out of combat. Only one trap can be active at a time."),
    (id: "aimed_shot_rank_6", spell: 20904, name: "Aimed Shot (Rank 6)", class: Hunter, level: 100, icon: "INV_Spear_07", cost: Mana(170.0), cooldown: 6.0, effect: Damage(min: 600.0, max: 605.0, range: 35.0),
        description: ""),
    (id: "trueshot_aura_rank_3", spell: 20906, name: "Trueshot Aura (Rank 3)", class: Hunter, level: 100, icon: "Ability_TrueShot", cost: Mana(289.0), cooldown: 1.5, effect: Classic(range: 0.0),
        description: "Increases the attack power of party members within 45 yards by 100. Lasts 30 min."),
    (id: "wyvern_sting_rank_3", spell: 24133, name: "Wyvern Sting (Rank 3)", class: Hunter, level: 100, icon: "INV_Spear_02", cost: Mana(113.0), cooldown: 120.0, effect: Classic(range: 35.0),
        description: "A stinging shot that puts the target to sleep for 12 sec. Any damage will cancel the effect. When the target wakes up, the Sting causes 600 Nature damage over 12 sec. Only usable out of combat. Only one Sting per Hunter can be active on the target at a time."),

