    (id: "i19237", name: "Sayge's Fortune #19", display: 3331, classic: true, class: 15, bind: Pickup, text: "The Forsaken are up to something.", handling: "Parchment_Paper"),
    (id: "i19238", name: "Sayge's Fortune #3", display: 3331, classic: true, class: 15, bind: Pickup, text: "An enemy from your past will soon become an ally.", handling: "Parchment_Paper"),
    (id: "i19239", name: "Sayge's Fortune #4", display: 3331, classic: true, class: 15, bind: Pickup, text: "You will be fortunate in everything you put your hands to.", handling: "Parchment_Paper"),
    (id: "i19240", name: "Sayge's Fortune #5", display: 3331, classic: true, class: 15, bind: Pickup, text: "Someone is speaking well of you.", handling: "Parchment_Paper"),
    (id: "i19241", name: "Sayge's Fortune #6", display: 3331, classic: true, class: 15, bind: Pickup, text: "Be cautious when landing in unfamiliar territory.", handling: "Parchment_Paper"),
    (id: "i19242", name: "Sayge's Fortune #7", display: 3331, classic: true, class: 15, bind: Pickup, text: "Avoid taking unnecessary gambles.", handling: "Parchment_Paper"),
    (id: "i19243", name: "Sayge's Fortune #8", display: 3331, classic: true, class: 15, bind: Pickup, text: "You will receive a fortune.", handling: "Parchment_Paper"),
    (id: "i19244", name: "Sayge's Fortune #9", display: 3331, classic: true, class: 15, bind: Pickup, text: "Your first love and last love is self-love.", handling: "Parchment_Paper"),
    (id: "i19245", name: "Sayge's Fortune #10", display: 3331, classic: true, class: 15, bind: Pickup, text: "Rest is a good thing, but boredom is its brother.", handling: "Parchment_Paper"),
    (id: "i19246", name: "Sayge's Fortune #11", display: 3331, classic: true, class: 15, bind: Pickup, text: "Those with simple tastes are always satisfied with the best.", handling: "Parchment_Paper"),
    (id: "i19247", name: "Sayge's Fortune #12", display: 3331, classic: true, class: 15, bind: Pickup, text: "Let not the tides of war wash you away.", handling: "Parchment_Paper"),
    (id: "i19248", name: "Sayge's Fortune #13", display: 3331, classic: true, class: 15, bind: Pickup, text: "You leave your adversaries speechless.", handling: "Parchment_Paper"),
    (id: "i19249", name: "Sayge's Fortune #14", display: 3331, classic: true, class: 15, bind: Pickup, text: "You have a good eye for spotting hypocrisy.", handling: "Parchment_Paper"),
    (id: "i19250", name: "Sayge's Fortune #15", display: 3331, classic: true, class: 15, bind: Pickup, text: "One learns most when teaching others.", handling: "Parchment_Paper"),
    (id: "i19251", name: "Sayge's Fortune #16", display: 3331, classic: true, class: 15, bind: Pickup, text: "The time will soon come for you to make a choice in a pressing matter.", handling: "Parchment_Paper"),
    (id: "i19252", name: "Sayge's Fortune #18", display: 3331, classic: true, class: 15, bind: Pickup, text: "Accept the next proposition you hear.", handling: "Parchment_Paper"),
    (id: "i19253", name: "Sayge's Fortune #17", display: 3331, classic: true, class: 15, bind: Pickup, text: "Never punt a gnome without due cause.", handling: "Parchment_Paper"),
    (id: "i19254", name: "Sayge's Fortune #21", display: 3331, classic: true, class: 15, bind: Pickup, text: "Divine Shields and Hearthstones do not make a hero heroic.", handling: "Parchment_Paper"),
    (id: "i19255", name: "Sayge's Fortune #22", display: 3331, classic: true, class: 15, bind: Pickup, text: "An answer in blue is always true.", handling: "Parchment_Paper"),
